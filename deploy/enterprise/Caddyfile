mcp-onshape.icesound.dk {
	log {
		output stdout
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
			}
			wrap json
		}
	}

	request_body {
		max_size 16MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy http://10.254.50.30:8080 {
		header_up Host {host}
		health_uri /ready
		health_interval 30s
		health_timeout 5s
		stream_close_delay 5m
	}
}
