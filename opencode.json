{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "onshape-rust-release": {
      "type": "local",
      "command": ["./target/release/onshape-mcp"],
      "enabled": false
    },
    "onshape-rust-debug": {
      "type": "local",
      "command": ["./target/debug/onshape-mcp"],
      "enabled": false
    },
    "onshape-npm-debug": {
      "type": "local",
      "command": ["node", "npm/onshape-mcp/bin.js"],
      "env": {
        "ONSHAPE_MCP_NPM_COMMAND": "./target/debug/onshape-mcp"
      },
      "enabled": true
    },
    "onshape-npm-release": {
      "type": "local",
      "command": ["node", "npm/onshape-mcp/bin.js"],
      "env": {
        "ONSHAPE_MCP_NPM_COMMAND": "./target/release/onshape-mcp"
      },
      "enabled": false
    },
    "onshape-rust-http": {
      "type": "remote",
      "url": "http://localhost:8080/mcp",
      "enabled": false
    }
  }
}
